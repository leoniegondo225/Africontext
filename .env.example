# Public URL of the app (used for the GitHub OAuth callback)
APP_URL=http://localhost:3000

# Signs session cookies. Required in production: openssl rand -hex 32
AUTH_SECRET=

# GitHub OAuth app (callback: $APP_URL/api/auth/github/callback). Leave empty to use the demo sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins with access to /admin
ADMIN_GITHUB_LOGINS=
# Comma-separated emails that get the admin role when they sign up with email + password
ADMIN_EMAILS=
# Set to 1 to keep the jury demo sign-in even with GitHub configured
DEMO_LOGIN=

# Shared secret for the nightly doc watch (docker-compose service "veille")
CRON_SECRET=

# PostgreSQL via Prisma (prisma/schema.prisma). Leave DATABASE_URL empty to run in memory only.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://africontext:${POSTGRES_PASSWORD}@db:5432/africontext

# AI-assisted draft (F11): Claude reads the doc URL and fills the Spec. Without it, /api/draft returns a skeleton.
ANTHROPIC_API_KEY=
